{
  "name": "polyvia",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for Polyvia AI platform",
  "author": "Polyvia AI <senyao@polyvia.ai>",
  "license": "MIT",
  "homepage": "https://polyvia.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/polyvia-ai/polyvia-js-sdk"
  },
  "bugs": {
    "url": "https://github.com/polyvia-ai/polyvia-js-sdk/issues"
  },
  "keywords": [
    "polyvia",
    "document",
    "ai",
    "mcp",
    "rag",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}